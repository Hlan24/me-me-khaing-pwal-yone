# Mi Mi Khine Pwal Yon — environment template
# Copy this file to .env.local only when your deployment/build process reads it.
# The current standalone dashboard pins its public browser configuration in
# public/pwal-yon-dashboard.html under globalThis.PWAL_YON_SUPABASE.

# Public browser configuration. A Supabase publishable key is designed for
# browser use; database access is still protected by Auth and RLS policies.
PWAL_YON_SUPABASE_URL=https://your-project-ref.supabase.co
PWAL_YON_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional server/admin tooling. Keep these values blank in browser builds and
# never commit real passwords, service-role keys, access tokens, or private keys.
SUPABASE_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local Cloudflare/vinext diagnostics.
WRANGLER_WRITE_LOGS=false
WRANGLER_LOG_PATH=.wrangler/logs
MINIFLARE_REGISTRY_PATH=.wrangler/registry
